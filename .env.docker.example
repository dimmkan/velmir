# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_DB=velmir_admin
POSTGRES_USER=velmir
POSTGRES_PASSWORD=replace-with-long-random-admin-db-password
# URL-encode the password inside DSNs. Use the same password as POSTGRES_PASSWORD.
ADMIN_DATABASE_URL=postgresql://velmir:replace-with-long-random-admin-db-password@admin-db:5432/velmir_admin?sslmode=disable
# Optional. Leave empty when no target database should be configured.
TARGET_DATABASE_URL=postgresql://velmir:replace-with-long-random-admin-db-password@admin-db:5432/velmir_demo?sslmode=disable
APP_ENV=production
SESSION_COOKIE_SECURE=true
VELMIR_HTTP_PORT=8080
LOG_LEVEL=info

# Required only for the first production bootstrap. Use a long random password.
VELMIR_BOOTSTRAP_ADMIN_LOGIN=admin
VELMIR_BOOTSTRAP_ADMIN_PASSWORD=administrator
VELMIR_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# Remove login/password after the first successful start. Existing users are never reset.

# Optional production tuning; these are the defaults.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
DATABASE_CONNECT_TIMEOUT=5s
ADMIN_DATABASE_MAX_CONNS=10
TARGET_DATABASE_MAX_CONNS=10
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_JSON_BODY_SIZE=1048576
