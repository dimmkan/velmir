ADMIN_DATABASE_URL=postgresql://velmir:velmir_local_only@localhost:5432/velmir_admin?sslmode=disable
TARGET_DATABASE_URL=postgresql://velmir_readonly:velmir_readonly_local_only@localhost:5433/velmir_demo?sslmode=disable
# Optional: leave empty for read-only mode. This example is for the local demo only.
TARGET_WRITE_DATABASE_URL=postgresql://velmir_writer:velmir_writer_local_only@localhost:5433/velmir_demo?sslmode=disable
HTTP_ADDR=127.0.0.1:8080

# Required only when the admin database has no users. Use a unique email and a long random password.
VELMIR_BOOTSTRAP_ADMIN_EMAIL=
VELMIR_BOOTSTRAP_ADMIN_PASSWORD=
# Remove both bootstrap values after the first administrator is created.

SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
