# Local backend development only. Do not commit the copied .env.
POSTGRES_DB=velmir_admin
POSTGRES_USER=velmir
POSTGRES_PASSWORD=velmir_local_only
ADMIN_DATABASE_URL=postgresql://velmir:velmir_local_only@localhost:5432/velmir_admin?sslmode=disable
TARGET_DATABASE_URL=postgresql://velmir_writer:velmir_writer_local_only@localhost:5433/velmir_demo?sslmode=disable
APP_ENV=development
VELMIR_DEMO_MODE=false
HTTP_ADDR=127.0.0.1:8080
FRONTEND_DIST_PATH=
LOG_LEVEL=info
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=24h
DATABASE_CONNECT_TIMEOUT=5s
ADMIN_DATABASE_MAX_CONNS=10
TARGET_DATABASE_MAX_CONNS=10
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_JSON_BODY_SIZE=1048576

# Required for the first local administrator when the admin database is empty.
VELMIR_BOOTSTRAP_ADMIN_LOGIN=
VELMIR_BOOTSTRAP_ADMIN_PASSWORD=
VELMIR_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# Remove bootstrap login/password after the administrator is created.
